# build artifacts — all builds output to /bin (folder kept, contents ignored)
/bin/*
!/bin/.gitkeep
*.exe
*.wasm
*.wasm.gz
/web/static/wasm_exec.js

# data & secrets — NEVER commit
# The whole runtime data dir, not just the databases: web/data/cashflux/blobs/
# holds users' attached FILES (receipts, statements) as loose content-addressed
# blobs, which no *.db pattern covers.
/web/data/
*.db
*.db-shm
*.db-wal
.env
.env.*

# os / editor
.DS_Store
Thumbs.db
*.log

# CashFlux build artifacts (regenerated by scripts/build-cashflux.sh)
web/cashflux/

# Screenshots written by e2e/terminal-flows.mjs --shots. Build artifacts: regenerate them,
# never commit them.
e2e/shots/
