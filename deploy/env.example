# earlcameron.com runtime configuration — template for /opt/earlcameron/.env
#
# deploy/install.sh generates the real file from this one (chmod 600, owned by the
# earlcameron user) and fills the secrets with `openssl rand`. Edit the live file with
# `sudoedit /opt/earlcameron/.env` and `systemctl restart earlcameron` to apply.
#
# Format is systemd EnvironmentFile: KEY=value, one per line, no `export`, no shell
# expansion. Values containing spaces need quoting.
#
# Every key below is read by internal/config/config.go or the CashFlux embed in
# internal/server — nothing here is aspirational.

# --- ingress ---------------------------------------------------------------------
# Bind loopback only. Nginx is the sole public listener; binding 0.0.0.0 would expose
# the app on :8095 past the firewall rules and past TLS.
LISTEN_ADDR=127.0.0.1:8095

# Public origin. Used to build absolute RSS links and to seed the CashFlux WebSocket
# origin check, so it must be the real https:// origin with NO trailing slash.
BASE_URL=https://earlcameron.com

# Extra permitted WebSocket upgrade origins, comma-separated. Same-origin is always
# allowed, so this normally stays empty — it exists for staging hosts.
ALLOWED_ORIGINS=

# --- data ------------------------------------------------------------------------
# Both paths live OUTSIDE the release directory so an update never touches user data
# and so the release tree can stay read-only under systemd's ProtectSystem=strict.
# These two paths are the only ones listed in the unit's ReadWritePaths.
DB_PATH=/opt/earlcameron/data/site.db
CASHFLUX_DATA_DIR=/opt/earlcameron/data/cashflux

# --- admin ------------------------------------------------------------------------
ADMIN_USERNAME=cam

# Leave ADMIN_PASSWORD empty to disable password login entirely and complete first-run
# owner setup in the browser instead — which is the safer default, provided you also
# set ADMIN_SETUP_TOKEN below so a stranger cannot claim the fresh deployment first.
ADMIN_PASSWORD=

# Signs admin session cookies. MUST be strong and MUST NOT be the dev default; install.sh
# generates one. Rotating it logs every admin session out, which is the intended
# revoke-all-sessions lever.
ADMIN_SECRET=

# Required to complete first-run owner setup. Closes the window between "service started"
# and "Cam created the account".
ADMIN_SETUP_TOKEN=

# Break-glass owner-password reset for when the recovery phrase is lost. Empty disables
# that path completely; only set it if you have somewhere safe to keep it.
ADMIN_RECOVERY_TOKEN=

# --- hosted CashFlux --------------------------------------------------------------
# Gates /budget/. Defaults to ADMIN_PASSWORD when unset; empty serves the app open.
BUDGET_PASSWORD=

# Gates CashFlux sync-account creation. Without it, anyone reaching /grpc can create an
# account on your sync engine.
CASHFLUX_SERVER_SETUP_CODE=

# Origin the embedded CashFlux engine accepts WebSocket upgrades from. Must be a bare
# scheme://host — a trailing path (or slash) makes its origin check reject every connect.
CASHFLUX_SERVER_APP_ORIGIN=https://earlcameron.com

# --- AI ----------------------------------------------------------------------------
# Enables the résumé tailor and the `ask` assistant. Empty disables both cleanly.
# Secret: env only, never web-editable, never in git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
